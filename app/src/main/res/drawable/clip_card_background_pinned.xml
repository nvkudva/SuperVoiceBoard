<?xml version="1.0" encoding="utf-8"?>
<!--
    WaveKey: a pinned clip. Violet is the panel's word for permanent — nothing
    else in it is violet — so a pinned card carries a violet hairline over the
    ordinary card fill. Only the stroke is coloured here; the fill is tinted by
    Colors like every other card.
    SPDX-License-Identifier: GPL-3.0-only
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
