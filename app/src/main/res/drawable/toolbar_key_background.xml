<?xml version="1.0" encoding="utf-8"?>
<!--
    WaveKey: the container behind a toolbar key, matching the tiles in the
    settings editor. White on purpose — Colors tints it with PorterDuff.MULTIPLY,
    so it takes whatever functional-key colour the theme carries.
    SPDX-License-Identifier: GPL-3.0-only
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="4dp">
    <shape android:shape="rectangle">
        <solid android:color="@android:color/white" />
        <corners android:radius="10dp" />
    </shape>
</inset>
