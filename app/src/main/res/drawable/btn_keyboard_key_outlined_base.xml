<?xml version="1.0" encoding="utf-8"?>
<!-- SuperVoiceBoard: Outlined key states. SPDX-License-Identifier: GPL-3.0-only -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Action keys keep the filled treatment: the send key is the one key that
         must not look like an outline among outlines. -->
    <!-- The action key keeps the style's own shape rather than LXX's circle:
         that circle is drawn with keepBackgroundAspectRatio, which these styles
         do not set, so it stretched into an oval on a wide enter key. It is the
         accent colour that marks it as the action, not a different silhouette:
         it takes the same resting drawable as every other key, so it carries the
         same outline or the same gradient and depth. -->
    <item android:state_active="true" android:state_pressed="true"
          android:drawable="@drawable/btn_keyboard_key_pressed_outlined_base" />
    <item android:state_active="true"
          android:drawable="@drawable/btn_keyboard_key_normal_outlined_base" />

    <item android:state_checkable="true" android:state_checked="true" android:state_pressed="true"
          android:drawable="@drawable/btn_keyboard_key_pressed_outlined_base" />
    <item android:state_checkable="true" android:state_pressed="true"
          android:drawable="@drawable/btn_keyboard_key_pressed_outlined_base" />
    <item android:state_checkable="true" android:state_checked="true"
          android:drawable="@drawable/btn_keyboard_key_pressed_outlined_base" />
    <item android:state_checkable="true"
          android:drawable="@drawable/btn_keyboard_key_normal_outlined_base" />

    <item android:state_empty="true" android:state_pressed="true"
          android:drawable="@drawable/btn_keyboard_key_pressed_outlined_base" />
    <item android:state_empty="true"
          android:drawable="@android:color/transparent" />

    <item android:state_pressed="true"
          android:drawable="@drawable/btn_keyboard_key_pressed_outlined_base" />
    <item android:drawable="@drawable/btn_keyboard_key_normal_outlined_base" />
</selector>
