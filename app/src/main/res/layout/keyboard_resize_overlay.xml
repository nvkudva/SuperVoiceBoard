<?xml version="1.0" encoding="utf-8"?>
<!--
    WaveKey: overlay shown on top of the keyboard while resize mode is active.
    SPDX-License-Identifier: GPL-3.0-only
-->
<helium314.keyboard.keyboard.KeyboardResizeOverlayView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#40000000"
    android:visibility="gone">

    <ImageView
        android:id="@+id/resize_handle_top"
        android:layout_width="88dp"
        android:layout_height="28dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/resize_handle_background"
        android:contentDescription="@string/resize_handle_height"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_resize_grip_vertical" />

    <ImageView
        android:id="@+id/resize_handle_bottom"
        android:layout_width="88dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/resize_handle_background"
        android:contentDescription="@string/resize_handle_bottom"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_resize_grip_vertical" />

    <ImageView
        android:id="@+id/resize_handle_left"
        android:layout_width="28dp"
        android:layout_height="88dp"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/resize_handle_background"
        android:contentDescription="@string/resize_handle_side"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_resize_grip_horizontal" />

    <ImageView
        android:id="@+id/resize_handle_right"
        android:layout_width="28dp"
        android:layout_height="88dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/resize_handle_background"
        android:contentDescription="@string/resize_handle_side"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_resize_grip_horizontal" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/resize_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/resize_button_background"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="@string/resize_reset"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/resize_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/resize_button_background"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="@string/resize_done"
            android:textColor="#FFFFFFFF" />
    </LinearLayout>
</helium314.keyboard.keyboard.KeyboardResizeOverlayView>
