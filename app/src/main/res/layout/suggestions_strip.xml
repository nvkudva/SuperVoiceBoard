<merge
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:animateLayoutChanges="true"
        android:id="@+id/suggestions_strip_wrapper"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false">
        <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
             We just need to ignore the system's audio and haptic feedback settings. -->
        <ImageButton
            android:id="@+id/suggestions_strip_toolbar_key"
            android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
            android:layout_height="@dimen/config_suggestions_strip_edge_key_width"
            android:layout_gravity="center_vertical"
            android:layout_weight="0"
            android:layout_marginStart="1dp"
            android:background="@drawable/toolbar_expand_key_background"
            style="?attr/suggestionWordStyle"
            android:contentDescription="@string/more_keys_strip_description" />
        <HorizontalScrollView
            android:id="@+id/toolbar_container"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/config_toolbar_key_inset"
                android:orientation="horizontal"
                style="?attr/suggestionWordStyle">
            </LinearLayout>
        </HorizontalScrollView>
        <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
             We just need to ignore the system's audio and haptic feedback settings. -->
        <!-- todo: sth is fishy with that maxwidth
               check what is going on in the layout helper? -->
        <LinearLayout
            android:id="@+id/suggestions_strip"
            android:orientation="horizontal"
            android:maxWidth="100dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:hapticFeedbackEnabled="false"
            android:soundEffectsEnabled="false" />
        <LinearLayout
            android:id="@+id/pinned_keys"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/config_toolbar_key_inset"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            style="?attr/suggestionWordStyle">
        </LinearLayout>
        <!-- WaveKey: AI fix sits beside the mic for the same reason the mic is
             here — it is the fork's own key, it must be reachable in every state
             of the row, and a key at the end of a scrolling toolbar is a key
             nobody finds. Like the mic, it is not a toolbar key. -->
        <ImageButton
            android:id="@+id/wavekey_ai_fix_key"
            android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
            android:layout_height="@dimen/config_suggestions_strip_edge_key_width"
            android:layout_gravity="center_vertical"
            android:layout_weight="0"
            style="?attr/suggestionWordStyle"
            android:contentDescription="@string/ai_fix" />
        <!-- WaveKey: the mic lives at the right-hand end of this row and
             stays there in every state of it — collapsed suggestions, expanded
             toolbar, empty strip. That is what Gboard does (see
             docs/reference/gboard-strip-idle.png), and it is why it is a sibling
             of pinned_keys rather than a pinned toolbar key: pinned keys are
             hidden whenever the toolbar is expanded. -->
        <ImageButton
            android:id="@+id/supervoiceboard_mic_key"
            android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
            android:layout_height="@dimen/config_suggestions_strip_edge_key_width"
            android:layout_gravity="center_vertical"
            android:layout_weight="0"
            style="?attr/suggestionWordStyle"
            android:contentDescription="@string/spoken_description_mic" />
    </LinearLayout>
</merge>
