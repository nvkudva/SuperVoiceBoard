<?xml version="1.0" encoding="utf-8"?>
<!--
    WaveKey: the container behind a toolbar key — the same rounded square the
    settings editor draws its key tiles in, so a key looks like a key wherever it
    is shown. White on purpose: Colors tints it with PorterDuff.MULTIPLY, so it
    takes whatever functional-key colour the theme carries.

    The key box is square, so an even inset lands a square tile. drawable-v23
    pins the size instead, because the pinned row stretches its keys.
    SPDX-License-Identifier: GPL-3.0-only
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="@dimen/config_toolbar_key_inset">
    <shape android:shape="rectangle">
        <solid android:color="@android:color/white" />
        <corners android:radius="10dp" />
    </shape>
</inset>
