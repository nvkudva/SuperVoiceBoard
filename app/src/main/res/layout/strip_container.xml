<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/config_suggestions_strip_height">
    <!-- To ensure that key preview popup is correctly placed when the current system locale is
         one of RTL locales, layoutDirection="ltr" is needed in the SDK version 17+. -->
    <helium314.keyboard.latin.suggestions.SuggestionStripView
        android:id="@+id/suggestion_strip_view"
        android:layoutDirection="ltr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        style="?attr/suggestionStripViewStyle" />
    <LinearLayout
        android:id="@+id/emoji_tab_strip"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="?attr/suggestionStripViewStyle" />
    <!-- WaveKey: voice is the fourth mode of this row, not a new bar
         (PLAN.md §2). Same FrameLayout, same height, same swap. -->
    <helium314.keyboard.voice.VoiceStripView
        android:id="@+id/voice_strip"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        style="?attr/suggestionStripViewStyle" />
    <HorizontalScrollView
        android:id="@+id/clipboard_strip_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="?attr/suggestionStripViewStyle"
        android:scrollbarThumbHorizontal="@color/toolbar_scrollbar" >
        <!-- WaveKey: the clipboard keys start where the text does. Upstream
             pushed them to the far edge with a weighted spacer, which put the
             first key furthest from the thumb that had just opened the strip. -->
        <LinearLayout
            android:id="@+id/clipboard_strip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start" />
    </HorizontalScrollView>
    <!-- WaveKey: the correction ghost draws over whichever mode is
         showing and never takes a touch. Removing the feature is removing this
         view and the helium314.keyboard.correct package. -->
    <helium314.keyboard.correct.GhostSwapView
        android:id="@+id/correction_ghost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
