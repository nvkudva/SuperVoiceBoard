<?xml version="1.0" encoding="utf-8"?>
<!--
    The Material style's key surface. White so that Colors.setColor can tint it
    with PorterDuff.Mode.MULTIPLY; the radius is what gives borderless keys a
    rounded press highlight instead of a hard rectangle.
    SPDX-License-Identifier: GPL-3.0-only
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/key_background_lxx_base" />
    <corners android:radius="12dp" />
</shape>
