<?xml version="1.0" encoding="utf-8"?>
<!--
    WaveKey: the Outlined style's resting key — a hairline, no fill.
    Drawn in white because Colors tints key backgrounds with PorterDuff.MULTIPLY:
    white becomes the theme's key colour, and the transparent interior stays
    transparent whatever the theme.
    SPDX-License-Identifier: GPL-3.0-only
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="@android:color/white" />
    <corners android:radius="7dp" />
</shape>
