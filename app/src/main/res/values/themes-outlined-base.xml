<?xml version="1.0" encoding="utf-8"?>
<!--
    WaveKey: the Outlined style — hairline keys, no fill — derived from
    the LXX base theme, which everything but the key background is shared with.
    SPDX-License-Identifier: Apache-2.0 AND GPL-3.0-only
-->
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="KeyboardTheme.Outlined_Base" parent="Keyboard">
        <item name="keyboardStyle">@style/Keyboard.Outlined_Base</item>
        <item name="keyboardViewStyle">@style/KeyboardView.Outlined_Base</item>
        <item name="mainKeyboardViewStyle">@style/MainKeyboardView.Outlined_Base</item>
        <item name="emojiPalettesViewStyle">@style/EmojiPalettesView.Outlined_Base</item>
        <item name="clipboardHistoryViewStyle">@style/ClipboardHistoryView.Outlined_Base</item>
        <item name="popupKeysKeyboardStyle">@style/PopupKeysKeyboard.Outlined_Base</item>
        <item name="popupKeysKeyboardViewStyle">@style/PopupKeysKeyboardView.Outlined_Base</item>
        <item name="popupKeysKeyboardViewForActionStyle">@style/PopupKeysKeyboardView.Outlined_Base.Action</item>
        <item name="suggestionStripViewStyle">@style/SuggestionStripView.Outlined_Base</item>
        <item name="suggestionWordStyle">@style/SuggestionWord.Outlined_Base</item>
    </style>
    <style
        name="Keyboard.Outlined_Base"
        parent="Keyboard"
    >
        <!-- This should be aligned with KeyboardTheme.THEME_ID_* -->
        <item name="themeId">OutlinedBase</item>
    </style>
    <style
        name="KeyboardView.Outlined_Base"
        parent="KeyboardView.LXX"
        >
        <item name="android:background">@color/keyboard_background_lxx_base</item>
        <item name="keyBackground">@drawable/btn_keyboard_key_outlined_base</item>
        <item name="functionalKeyBackground">@drawable/btn_keyboard_key_outlined_base</item>
        <item name="keyTextInactivatedColor">@color/key_text_inactive_color_lxx_light</item>
        <item name="keyShiftedLetterHintInactivatedColor">@color/key_text_inactive_color_lxx_light</item>
        <item name="keyShiftedLetterHintActivatedColor">@color/key_text_color_lxx_light</item>
    </style>
    <style
        name="MainKeyboardView.Outlined_Base"
        parent="KeyboardView.Outlined_Base"
        >
        <item name="popupKeysKeyboardForActionLayout">@layout/popup_keys_keyboard_for_action_lxx</item>
        <item name="keyPreviewBackground">@drawable/keyboard_key_feedback_lxx_light</item>
        <item name="keyPreviewOffset">@dimen/config_key_preview_offset_lxx</item>
        <!-- A negative value to disable text shadow layer. -->
        <item name="languageOnSpacebarTextShadowRadius">-1.0</item>
    </style>
    <!-- Though {@link helium314.keyboard.keyboard.emoji.EmojiPalettesView} doesn't extend
         {@link helium314.keyboard.keyboard.KeyboardView}, some views inside it, for instance
         delete button, need themed {@link helium314.keyboard.keyboard.KeyboardView}
         attributes. -->
    <style
        name="EmojiPalettesView.Outlined_Base"
        parent="MainKeyboardView.Outlined_Base"
        >
        <item name="categoryPageIndicatorBackground">@color/emoji_tab_page_indicator_background_lxx_base</item>
        <item name="iconEmojiRecentsTab">@drawable/ic_emoji_recents_lxx</item>
        <item name="iconEmojiSmileysTab">@drawable/ic_emoji_smileys_emotion_lxx</item>
        <item name="iconEmojiPeopleTab">@drawable/ic_emoji_people_body_lxx</item>
        <item name="iconEmojiNatureTab">@drawable/ic_emoji_animals_nature_lxx</item>
        <item name="iconEmojiFoodTab">@drawable/ic_emoji_food_drink_lxx</item>
        <item name="iconEmojiTravelPlacesTab">@drawable/ic_emoji_travel_places_lxx</item>
        <item name="iconEmojiActivitiesTab">@drawable/ic_emoji_activities_lxx</item>
        <item name="iconEmojiObjectsTab">@drawable/ic_emoji_objects_lxx</item>
        <item name="iconEmojiSymbolsTab">@drawable/ic_emoji_symbols_lxx</item>
        <item name="iconEmojiFlagsTab">@drawable/ic_emoji_flags_lxx</item>
        <item name="iconEmojiEmoticonsTab">@drawable/ic_emoji_emoticons_lxx</item>
    </style>
    <style
        name="ClipboardHistoryView.Outlined_Base"
        parent="MainKeyboardView.Outlined_Base"
        >
        <item name="iconPinnedClip">@drawable/ic_clipboard_pin_lxx</item>
    </style>
    <style
        name="PopupKeysKeyboard.Outlined_Base"
        parent="Keyboard.Outlined_Base"
        >
        <item name="keyboardTopPadding">0%p</item>
        <item name="keyboardBottomPadding">0%p</item>
        <item name="keyboardLeftPadding">0%p</item>
        <item name="keyboardRightPadding">0%p</item>
        <item name="horizontalGap">0%p</item>
        <item name="touchPositionCorrectionData">@null</item>
    </style>
    <style
        name="PopupKeysKeyboardView.Outlined_Base"
        parent="KeyboardView.Outlined_Base"
        >
        <item name="android:background">@drawable/keyboard_popup_panel_background_lxx_base</item>
        <item name="keyBackground">@drawable/btn_keyboard_key_popup_lxx_base</item>
        <item name="divider">@drawable/popup_keys_divider</item>
        <item name="keyTypeface">normal</item>
        <item name="verticalCorrection">@dimen/config_popup_keys_keyboard_vertical_correction_holo</item>
    </style>
    <style
        name="PopupKeysKeyboardView.Outlined_Base.Action"
        parent="PopupKeysKeyboardView.Outlined_Base"
        >
        <item name="android:background">@android:color/transparent</item>
        <item name="keyBackground">@drawable/btn_keyboard_key_popup_action_lxx_base</item>
        <item name="divider">@null</item>
        <item name="keyLabelFlags">keepBackgroundAspectRatio</item>
    </style>
    <style
        name="SuggestionStripView.Outlined_Base"
        parent="KeyboardView.Outlined_Base"
        >
        <item name="suggestionsCountInStrip">@integer/config_suggestions_count_in_strip</item>
        <item name="centerSuggestionPercentile">@fraction/config_center_suggestion_percentile</item>
        <item name="maxMoreSuggestionsRow">@integer/config_max_more_suggestions_row</item>
        <item name="minMoreSuggestionsWidth">@fraction/config_min_more_suggestions_width</item>
        <item name="android:background">@drawable/keyboard_background_lxx_base</item>
        <item name="android:src">@drawable/suggestions_strip_divider</item>
        <item name="suggestionStripOptions">autoCorrectBold|validTypedWordBold</item>
        <item name="alphaObsoleted">70%</item>
    </style>
    <style
        name="SuggestionWord.Outlined_Base"
        parent="SuggestionWord"
        >
        <item name="android:background">@drawable/btn_suggestion_lxx_base</item>
        <item name="android:textColor">@color/highlight_color_lxx_light</item>
    </style>
</resources>
